   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "from src.utils import load_data, save_predictions\n",
    "from sklearn.pipeline import Pipeline\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "from sklearn.linear_model import Ridge\n",
    "from catboost import CatBoostRegressor\n",
    "from sklearn.model_selection import KFold, cross_val_score\n",
    "\n",
    "# -------------------------------\n",
    "# 1. Загрузка данных и удаление дубликатов\n",
    "# -------------------------------\n",
    "df_x_train, df_y_train, df_test = load_data('../data_pizdata')\n",
    "\n",
    "duplicates = [(4, 12), (5, 13), (6, 14), (7, 15)]\n",
    "try:\n",
    "    print('Дубликаты: ')\n",
    "    for i in duplicates:\n",
    "        cnt = np.sum(df_x_train.iloc[:, i[0]] == df_x_train.iloc[:, i[1]])\n",
    "        total = len(df_x_train)\n",
    "        print(f'{i}: {cnt} из {total}')\n",
    "    \n",
    "    df_x_train.drop(columns=[i[0] for i in duplicates], inplace=True)\n",
    "    df_test.drop(columns=[i[0] for i in duplicates], inplace=True)\n",
    "    print('Дубликаты удалены')\n",
    "except Exception:\n",
    "    print('Дубликаты уже удалены')\n",
    "\n",
    "print(\"Количество признаков после удаления дубликатов:\", df_x_train.shape[1])\n",
    "assert df_x_train.shape[1] == 12\n",
    "\n",
    "RANDOM_STATE = 42\n",
    "\n",
    "# -------------------------------\n",
    "# 2. Функция для добавления новых признаков\n",
    "# -------------------------------\n",
    "def add_features(X):\n",
    "    new_features = []\n",
    "    \n",
    "    # Фича 27: сумма по строкам\n",
    "    sum_f = np.sum(X, axis=1, keepdims=True)\n",
    "    new_features.append(sum_f)\n",
    "    \n",
    "    # Фича 28: среднее по строкам\n",
    "    mean_f = np.mean(X, axis=1, keepdims=True)\n",
    "    new_features.append(mean_f)\n",
    "    \n",
    "    # Фича 39: количество значений выше среднего\n",
    "    count_above_mean = np.sum(X > mean_f, axis=1, keepdims=True)\n",
    "    new_features.append(count_above_mean)\n",
    "    \n",
    "    # Фича 41: логарифм абсолютных значений для первых 4 признаков\n",
    "    log_features = np.log1p(np.abs(X[:, :4]))\n",
    "    new_features.append(log_features)\n",
    "    \n",
    "    # Фича 42: квадратный корень для признаков 4-8\n",
    "    sqrt_features = np.sqrt(np.abs(X[:, 4:8]) + 1e-6)\n",
    "    new_features.append(sqrt_features)\n",
    "    \n",
    "    # Новые преобразования для фич 10, 11, 12 (индексы 9, 10, 11)\n",
    "    f10 = X[:, 9:10]\n",
    "    f11 = X[:, 10:11]\n",
    "    f12 = X[:, 11:12]\n",
    "    \n",
    "    new_features.append(np.sqrt(np.abs(f12)))          # Фича 43\n",
    "    new_features.append(f12 ** 2)                      # Фича 44\n",
    "    new_features.append(f10 * f12)                     # Фича 45\n",
    "    new_features.append((f11 + f12) / (f10 + 1e-6))    # Фича 46\n",
    "    new_features.append(np.where(f12 < np.median(f12), 0, 1)) # Фича 47\n",
    "    new_features.append(np.log1p(np.abs(f10 + f11)))   # Фича 48\n",
    "    new_features.append((f10 + f11 + f12) / 3)         # Фича 49\n",
    "    new_features.append(np.max([f10, f11, f12], axis=0)) # Фича 50\n",
    "    \n",
    "    return np.hstack([X] + new_features)\n",
    "\n",
    "# -------------------------------\n",
    "# 3. Обучение линейной модели (Ridge) на расширенных признаках\n",
    "# -------------------------------\n",
    "# Для линейной модели будем использовать расширенные признаки\n",
    "df_x_train_mod = add_features(df_x_train.values)\n",
    "df_test_mod = add_features(df_test.values)\n",
    "\n",
    "# Обучаем линейную модель с фиксированным α=10 (без перебора параметров и CV)\n",
    "linear_model = Pipeline([\n",
    "    ('scaler', StandardScaler()),\n",
    "    ('ridge', Ridge(alpha=10, random_state=RANDOM_STATE))\n",
    "])\n",
    "linear_model.fit(df_x_train_mod, df_y_train[0].values)\n",
    "\n",
    "# Получаем предсказания линейной модели для обучающего и тестового наборов\n",
    "y_pred_lin_train = linear_model.predict(df_x_train_mod)\n",
    "y_pred_lin_test = linear_model.predict(df_test_mod)\n",
    "\n",
    "# -------------------------------\n",
    "# 4. Добавление предсказаний линейной модели как нового признака для CatBoost\n",
    "# -------------------------------\n",
    "# Преобразуем исходный набор для CatBoost (после удаления дубликатов) в DataFrame\n",
    "df_x_train_cb = pd.DataFrame(df_x_train.copy(), \n",
    "                             columns=[f'feature_{i}' for i in range(df_x_train.shape[1])])\n",
    "df_test_cb = pd.DataFrame(df_test.copy(), \n",
    "                          columns=[f'feature_{i}' for i in range(df_test.shape[1])])\n",
    "\n",
    "# Добавляем столбец с предсказаниями линейной модели\n",
    "df_x_train_cb['linear_pred'] = y_pred_lin_train\n",
    "df_test_cb['linear_pred'] = y_pred_lin_test\n",
    "\n",
    "# -------------------------------\n",
    "# 5. Обучение модели CatBoost на дополненном наборе признаков\n",
    "# -------------------------------\n",
    "params_cb = {\n",
    "    'iterations': 30000,\n",
    "    'learning_rate': 0.019460075699874305,\n",
    "    'depth': 7,\n",
    "    'l2_leaf_reg': 3,\n",
    "    'border_count': 128,\n",
    "    'bagging_temperature': 1,\n",
    "    'random_strength': 5,\n",
    "    'grow_policy': 'SymmetricTree',\n",
    "    'min_data_in_leaf': 1\n",
    "}\n",
    "cv = KFold(n_splits=5, shuffle=True, random_state=RANDOM_STATE)\n",
    "cat_model = CatBoostRegressor(**params_cb, random_state=RANDOM_STATE, verbose=0)\n",
    "\n",
    "scores_cb = cross_val_score(cat_model, df_x_train_cb, df_y_train.iloc[:, 0],\n",
    "                            scoring='neg_mean_squared_error', cv=cv, n_jobs=-1)\n",
    "cv_mse_cb = -scores_cb\n",
    "print(\"CatBoost CV MSE scores:\", cv_mse_cb)\n",
    "print(\"Среднее CV MSE CatBoost:\", np.mean(cv_mse_cb))\n"
   ],
   "metadata": {
    "collapsed": false
   },
   "id": "938cc5aa09a7f4b8"
  }
 ],
