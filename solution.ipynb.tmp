   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import os\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.metrics import mean_squared_error\n",
    "from catboost import CatBoostRegressor\n",
    "from src.const import PATH_TO_DATA, RANDOM_STATE\n",
    "from sklearn.model_selection import KFold, cross_val_score\n",
    "from sklearn.model_selection import KFold, GridSearchCV\n"
   ]
  },
  {
   "cell_type": "markdown",
   "source": [
    "## Загрузка данных"
   ],
   "metadata": {
    "collapsed": false
   },
   "id": "ec639dbf93ebec07"
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "outputs": [],
   "source": [
    "from src.utils import load_data\n",
    "df_x_train, df_y_train, df_test = load_data()"
   ],
   "metadata": {
    "collapsed": false,
    "ExecuteTime": {
     "end_time": "2025-04-10T10:55:56.889606700Z",
     "start_time": "2025-04-10T10:55:56.703794900Z"
    }
   },
   "id": "d92e5ae9826c101a"
  },
  {
   "cell_type": "markdown",
   "source": [
    "## Удаление дубликатов\n",
    "Смотрим на карту корреляции, видно, что данные фичи просто дублируется\n",
    "По pairplot_test видно, что в 4, 5, 6, 7 данные испорченны"
   ],
   "metadata": {
    "collapsed": false
   },
   "id": "e9c506bf09e31ca9"
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Дубликаты: \n",
      "(4, 12): 40000 из 40000\n",
      "(5, 13): 40000 из 40000\n",
      "(6, 14): 40000 из 40000\n",
      "(7, 15): 40000 из 40000\n",
      "Дубликаты удалены\n"
     ]
    }
   ],
   "source": [
    "def remove_duplicate_columns(train_df, test_df, duplicates=None):\n",
    "    duplicates = [(4, 12), (5, 13), (6, 14), (7, 15)]\n",
    "        \n",
    "    try:\n",
    "        print('Дубликаты: ')\n",
    "        for pair in duplicates:\n",
    "            col1, col2 = pair\n",
    "            matches = np.sum(train_df.iloc[:, col1] == train_df.iloc[:, col2])\n",
    "            total = len(train_df)\n",
    "            print(f'{pair}: {matches} из {total}')\n",
    "            \n",
    "        cols_to_drop = [pair[0] for pair in duplicates]\n",
    "        train_df = train_df.drop(columns=cols_to_drop)\n",
    "        test_df = test_df.drop(columns=cols_to_drop)\n",
    "        print('Дубликаты удалены')\n",
    "        \n",
    "    except Exception as e:\n",
    "        print(f'Ошибка при удалении дубликатов: {str(e)}')\n",
    "    \n",
    "    assert train_df.shape[1] == 12, f\"Ожидалось 12 столбцов, получено {train_df.shape[1]}\"\n",
    "    \n",
    "    return train_df, test_df\n",
    "\n",
    "df_x_train, df_test = remove_duplicate_columns(df_x_train, df_test)"
   ],
   "metadata": {
    "collapsed": false,
    "ExecuteTime": {
     "end_time": "2025-04-10T10:56:01.358643300Z",
     "start_time": "2025-04-10T10:56:01.338032700Z"
    }
   },
   "id": "de670431e952edd2"
  },
  {
   "cell_type": "markdown",
   "source": [
    "## Перебор параметров в [Коллабе](https://colab.research.google.com/drive/1spgSNc9w3xKS6wLXHbPleKNJmt0fPbqU#scrollTo=h7Nl6THeP9Bd)\n"
   ],
   "metadata": {
    "collapsed": false
   },
   "id": "a9f4388b1d804bae"
  },
  {
   "cell_type": "markdown",
   "source": [
    "## Скор на кросс-валидации"
   ],
   "metadata": {
    "collapsed": false
   },
   "id": "70f68258247b955c"
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "CV MSE scores: [0.01487684 0.0145606  0.01439894 0.01445993 0.01473303]\n",
      "Среднее CV MSE: 0.014605868795768227\n"
     ]
    }
   ],
   "source": [
    "params = {'iterations': 30000, 'learning_rate': 0.019460075699874305, 'depth': 7, 'l2_leaf_reg': 3, 'border_count': 128, 'bagging_temperature': 1, 'random_strength': 5, 'grow_policy': 'SymmetricTree', 'min_data_in_leaf': 1}\n",
    "\n",
    "cv = KFold( n_splits=5, shuffle=True, random_state=RANDOM_STATE)\n",
    "model = CatBoostRegressor(**params, random_state=RANDOM_STATE, verbose=0)\n",
    "scores = cross_val_score(model, df_x_train, df_y_train[0], cv=cv,\n",
    "                         scoring='neg_mean_squared_error', n_jobs=-1)\n",
    "\n",
    "cv_mse_scores = -scores\n",
    "print(\"CV MSE scores:\", cv_mse_scores)\n",
    "print(\"Среднее CV MSE:\", np.mean(cv_mse_scores))\n"
   ],
   "metadata": {
    "collapsed": false,
    "ExecuteTime": {
     "end_time": "2025-04-10T11:03:17.568545900Z",
     "start_time": "2025-04-10T10:56:13.102978Z"
    }
   },
   "id": "66ba572648c253f4"
  },
